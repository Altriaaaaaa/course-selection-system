<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CourseMapper">

    <resultMap type="Course" id="CourseResult">
        <id     property="cno"        column="cno"        />
        <result property="cname"      column="cname"      />
        <result property="credit"     column="credit"     />
        <result property="hours"      column="hours"      />
        <result property="courseType" column="course_type"/>
        <result property="deptId"     column="dept_id"    />
        <result property="adminId"    column="admin_id"   />
        <result property="deptName"   column="dept_name"  />
        <result property="maxStudents" column="max_students"/>
        <result property="enrolledCount" column="enrolled_count"/>
        <result property="status"       column="status"       />
        <result property="rejectReason" column="reject_reason"/>
        <result property="teacherName" column="teacherName"/>
    </resultMap>

    <sql id="selectCourseVo">
        select c.cno, c.cname, c.credit, c.hours, c.course_type, c.dept_id, c.admin_id, d.dept_name, c.max_students, (select count(*) from courseselection cs2 where cs2.cno = c.cno) as enrolled_count, t.tname as teacherName
        from course c left join department d on c.dept_id = d.dept_id left join class cl on c.cno = cl.cno left join teacher t on cl.tno = t.tno
    </sql>

    <select id="selectCourseList" parameterType="Course" resultMap="CourseResult">
        <include refid="selectCourseVo"/>
        <where>
            <if test="cno != null and cno != ''">
                and c.cno like concat('%', #{cno}, '%')
            </if>
            <if test="cname != null and cname != ''">
                and c.cname like concat('%', #{cname}, '%')
            </if>
            <if test="courseType != null"> and c.course_type = #{courseType}</if>
            <if test="deptId != null and deptId != 0">
                and c.dept_id = #{deptId}
            </if>
            <if test="adminId != null and adminId != ''"> and c.admin_id = #{adminId}</if>
            <if test="teacherName != null and teacherName != ''">and t.tname like concat('%', #{teacherName}, '%')</if>
            <if test="creditMin != null">and c.credit &gt;= #{creditMin}</if>
            <if test="creditMax != null">and c.credit &lt;= #{creditMax}</if>
        </where>
        group by c.cno, c.cname, c.credit, c.hours, c.course_type, c.dept_id, c.admin_id, d.dept_name, c.max_students, t.tname
        order by c.cno
    </select>

    <select id="selectCourseById" parameterType="String" resultMap="CourseResult">
        select * from (
            <include refid="selectCourseVo"/>
            where c.cno = #{cno}
        ) t limit 1
    </select>

    <select id="checkCnoUnique" parameterType="String" resultMap="CourseResult">
        <include refid="selectCourseVo"/>
        where c.cno = #{cno} limit 1
    </select>

    <select id="checkCnameUnique" parameterType="String" resultMap="CourseResult">
        <include refid="selectCourseVo"/>
        where c.cname = #{cname} limit 1
    </select>

    <insert id="insertCourse" parameterType="Course">
        insert into course
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="cno != null and cno != ''">cno,</if>
            <if test="cname != null and cname != ''">cname,</if>
            <if test="credit != null">credit,</if>
            <if test="hours != null">hours,</if>
            <if test="courseType != null">course_type,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="adminId != null and adminId != ''">admin_id,</if>
            <if test="maxStudents != null">max_students,</if>
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="cno != null and cno != ''">#{cno},</if>
            <if test="cname != null and cname != ''">#{cname},</if>
            <if test="credit != null">#{credit},</if>
            <if test="hours != null">#{hours},</if>
            <if test="courseType != null">#{courseType},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="adminId != null and adminId != ''">#{adminId},</if>
            <if test="maxStudents != null">#{maxStudents},</if>
        </trim>
    </insert>

    <update id="updateCourse" parameterType="Course">
        update course
        <set>
            <if test="cname != null and cname != ''">cname = #{cname},</if>
            <if test="credit != null">credit = #{credit},</if>
            <if test="hours != null">hours = #{hours},</if>
            <if test="courseType != null">course_type = #{courseType},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="maxStudents != null">max_students = #{maxStudents},</if>
        </set>
        where cno = #{cno}
    </update>

    <delete id="deleteCourseById" parameterType="String">
        delete from course where cno = #{cno}
    </delete>

    <select id="selectEnrolledCount" parameterType="String" resultType="int">
        select count(*) from courseselection where cno = #{cno}
    </select>

</mapper>


